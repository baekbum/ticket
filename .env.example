# JWT를 발급하거나 검증하는 모든 서비스에서 같은 값을 사용해야 합니다.
TOKEN_SECRET=replace-with-at-least-32-byte-random-secret

# ticket-service와 payment-gateway-service 사이의 내부 호출에 같은 값을 사용합니다.
APP_INTERNAL_SERVICE_TOKEN=replace-with-a-random-internal-service-token

# 외부 결제 제공자가 가상계좌 입금을 통지할 때 사용합니다.
APP_PAYMENT_PROVIDER_TOKEN=replace-with-a-random-payment-provider-token
