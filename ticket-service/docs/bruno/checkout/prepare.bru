meta {
  name: Prepare Checkout
  type: http
  seq: 1
}

post {
  url: {{ticketBaseUrl}}/checkout/prepare
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Active-Token: {{activeToken}}
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "orderId": "ORD-BRU-{{$timestamp}}",
    "eventId": {{eventId}},
    "seats": [
      {
        "id": {{seatId}},
        "zone": "VIP",
        "row": 1,
        "col": 1
      }
    ],
    "idempotencyKey": "BRU-{{$timestamp}}"
  }
}
