meta {
  name: Approve Card Payment
  type: http
  seq: 1
}

post {
  url: {{paymentGatewayBaseUrl}}/payments/card/approve
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "paymentNo": "{{paymentNo}}",
    "cardCompany": "{{cardCompany}}",
    "cardNumber": "{{cardNumber}}",
    "cvc": "{{cardCvc}}",
    "cardPassword": "{{cardPassword}}",
    "customerName": "{{cardCustomerName}}",
    "amount": {{depositAmount}}
  }
}
