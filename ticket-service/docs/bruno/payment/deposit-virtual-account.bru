meta {
  name: Deposit Virtual Account
  type: http
  seq: 3
}

post {
  url: {{paymentGatewayBaseUrl}}/payments/virtual-account/deposit
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "accountNumber": "{{accountNumber}}",
    "depositorName": "이지은",
    "amount": {{depositAmount}},
    "depositedAt": "2026-08-20T12:00:00"
  }
}
