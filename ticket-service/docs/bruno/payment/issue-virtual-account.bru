meta {
  name: Issue Virtual Account
  type: http
  seq: 2
}

post {
  url: {{ticketBaseUrl}}/payments/virtual-account/issue
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
  X-Queue-Token: {{queueToken}}
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "paymentNo": "{{paymentNo}}",
    "bankCode": "{{bankCode}}",
    "depositorName": "{{depositorName}}"
  }
}
