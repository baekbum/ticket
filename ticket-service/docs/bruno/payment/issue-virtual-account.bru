meta {
  name: Issue Virtual Account
  type: http
  seq: 2
}

post {
  url: {{paymentGatewayBaseUrl}}/payments/virtual-account/issue
  body: json
  auth: bearer
}

headers {
  Content-Type: application/json
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "paymentNo": "{{paymentNo}}",
    "bankCompany": "{{bankCode}}",
    "amount": {{depositAmount}},
    "eventDateTime": "2026-09-18T18:00:00",
    "ticketPaymentApplyRequired": true
  }
}
